{
  // FicheAssur in one codespace: this site, plus the backend repo, which
  // setup.sh clones next to it under /workspaces.
  "name": "FicheAssur",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "mehdibenrabiaa/ficheassur_backend": { "permissions": { "contents": "write" } }
      },
      "openFiles": [".devcontainer/README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  },
  "forwardPorts": [3100, 8100],
  "portsAttributes": {
    "3100": { "label": "Site", "onAutoForward": "openBrowser" },
    "8100": { "label": "Backend API" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh"
}
